    "nuxt": "^4.4.2",
    "plyr": "^3.8.4",
    "sweetalert2": "^11.26.24",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.2",
    "@playwright/test": "^1.59.1",
    "@types/ioredis": "^5.0.0",
